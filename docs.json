{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Need Alert",
  "description": "Filas de espera e alertas sob demanda para qualquer negócio.",
  "colors": {
    "primary": "#465FFF",
    "light": "#7C8CFF",
    "dark": "#3641CC"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navigation": {
    "languages": [
      {
        "language": "pt-BR",
        "default": true,
        "tabs": [
          {
            "tab": "Guias",
            "groups": [
              {
                "group": "Começando",
                "pages": ["index", "como-funciona", "casos-de-uso"]
              },
              {
                "group": "Para estabelecimentos",
                "pages": [
                  "estabelecimentos/primeiros-passos",
                  "estabelecimentos/itens-e-qr-code",
                  "estabelecimentos/disparar-alertas",
                  "estabelecimentos/agendar-disparos",
                  "estabelecimentos/creditos",
                  "estabelecimentos/equipe-e-papeis",
                  "estabelecimentos/catalogo-da-rede"
                ]
              },
              {
                "group": "Para quem espera",
                "pages": [
                  "clientes/entrar-na-fila",
                  "clientes/minhas-filas",
                  "clientes/avisos-e-app"
                ]
              }
            ]
          },
          {
            "tab": "API",
            "groups": [
              {
                "group": "API",
                "pages": ["api/visao-geral", "api/convencoes"]
              }
            ]
          }
        ]
      },
      {
        "language": "en",
        "tabs": [
          {
            "tab": "Guides",
            "groups": [
              {
                "group": "Getting started",
                "pages": ["en/index", "en/how-it-works", "en/use-cases"]
              },
              {
                "group": "For establishments",
                "pages": [
                  "en/establishments/getting-started",
                  "en/establishments/items-and-qr-codes",
                  "en/establishments/send-alerts",
                  "en/establishments/schedule-alerts",
                  "en/establishments/credits",
                  "en/establishments/team-and-roles",
                  "en/establishments/chain-catalog"
                ]
              },
              {
                "group": "For people waiting",
                "pages": [
                  "en/customers/join-a-queue",
                  "en/customers/my-queues",
                  "en/customers/alerts-and-app"
                ]
              }
            ]
          },
          {
            "tab": "API",
            "groups": [
              {
                "group": "API",
                "pages": ["en/api/overview", "en/api/conventions"]
              }
            ]
          }
        ]
      }
    ]
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude", "perplexity", "mcp", "cursor", "vscode"]
  }
}
